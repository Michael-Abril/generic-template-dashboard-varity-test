{
  "name": "varity-generic-company-dashboard",
  "version": "1.0.0",
  "description": "Generic company-specific AI dashboard template integrating all Varity L3 apps",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "contracts:deploy": "hardhat run scripts/deploy.js --network arbitrum_sepolia",
    "contracts:deploy:varity": "hardhat run scripts/deploy.js --network varity_testnet",
    "contracts:verify": "hardhat run scripts/verify.js --network arbitrum_sepolia",
    "contracts:test": "hardhat test",
    "contracts:compile": "hardhat compile",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [
    "varity",
    "company-dashboard",
    "ai-dashboard",
    "tool-aggregation",
    "privy",
    "thirdweb",
    "web3"
  ],
  "author": "Varity",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@privy-io/react-auth": "^1.73.0",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "thirdweb": "^5.112.1",
    "viem": "^2.7.0",
    "wagmi": "^2.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.3",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^2.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.1",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lucide-react": "^0.554.0",
    "postcss": "^8.4.32",
    "simple-icons": "^15.20.0",
    "solidity-coverage": "^0.8.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
