{
  "name": "varity-generic-company-dashboard",
  "version": "1.0.0",
  "description": "Generic company-specific AI dashboard template integrating all Varity L3 apps",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'npm run type-check'"
    ]
  },
  "keywords": [
    "varity",
    "company-dashboard",
    "ai-dashboard",
    "privy",
    "thirdweb",
    "web3"
  ],
  "author": "Varity",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@next/bundle-analyzer": "^16.1.0",
    "@privy-io/react-auth": "^1.73.0",
    "@solana/assertions": "^5.1.0",
    "@solana/codecs": "^5.1.0",
    "@solana/errors": "^5.1.0",
    "@types/react-grid-layout": "^1.3.6",
    "d3-array": "^3.2.4",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "thirdweb": "^5.112.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lucide-react": "^0.554.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
