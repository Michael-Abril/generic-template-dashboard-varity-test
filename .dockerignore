# Dependencies
node_modules
.pnpm-store

# Build output (for dev containers)
.next
out
dist
build

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (use build args instead)
.env
.env.*
!.env.example
!.env.local.example
!.env.production.example

# IDE and editor files
.idea
.vscode
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore

# Documentation (not needed in container)
*.md
!README.md
docs/
CLAUDE.md

# Tests (not needed in production image)
__tests__
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx
coverage
jest.config.*
playwright.config.*
playwright-report

# Smart contracts (separate deployment)
contracts
hardhat.config.*

# Reports and temporary files
*.report.md
REPORT*.md
*_REPORT*.md
*.log
tmp/
temp/

# CI/CD
.github
.gitlab-ci.yml
.circleci

# Docker files for nested builds
Dockerfile*
docker-compose*
!Dockerfile
!docker-compose.yml
!docker-compose.prod.yml

# Backend (for frontend builds - has its own Dockerfile)
backend/

# TypeScript build info
*.tsbuildinfo

# Optional npm cache
.npm

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache
