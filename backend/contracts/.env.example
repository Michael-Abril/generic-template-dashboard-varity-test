# Varity Smart Contracts - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DEPLOYMENT CREDENTIALS
# =============================================================================

# Private key for deploying contracts (without 0x prefix)
# SECURITY: Never commit the actual private key to git!
DEPLOYER_PRIVATE_KEY=your_private_key_here

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Varity L3 Testnet (Arbitrum Stack - AnyTrust via Conduit)
VARITY_TESTNET_RPC=https://rpc-varity-testnet-rroe52pwjp.t.conduit.xyz
VARITY_TESTNET_CHAIN_ID=33529
VARITY_TESTNET_EXPLORER=https://explorer-varity-testnet-rroe52pwjp.t.conduit.xyz/

# Native Token on Varity L3 (USDC)
VARITY_NATIVE_TOKEN=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# =============================================================================
# CONTRACT ADDRESSES (After Deployment)
# =============================================================================

# VarityDataCommitments contract address (fill after deployment)
VARITY_DATA_COMMITMENTS_ADDRESS=

# =============================================================================
# EXPLORER VERIFICATION
# =============================================================================

# Etherscan/Blockscout API key for contract verification
# Note: Conduit explorer may use Blockscout-compatible API
ETHERSCAN_API_KEY=

# =============================================================================
# BACKEND INTEGRATION
# =============================================================================

# After deployment, add these to backend .env:
# VARITY_L3_RPC_URL=https://rpc-varity-testnet-rroe52pwjp.t.conduit.xyz
# VARITY_L3_CHAIN_ID=33529
# VARITY_DATA_COMMITMENTS_ADDRESS=<deployed_address>
# VARITY_SIGNER_PRIVATE_KEY=<backend_signer_key>
