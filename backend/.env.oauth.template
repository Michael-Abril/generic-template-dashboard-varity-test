# OAuth Configuration Template for Varity L3 Marketplace
# Copy this file to .env and add your real OAuth credentials

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret_here
QUICKBOOKS_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/quickbooks/callback

# Stripe OAuth
STRIPE_CLIENT_ID=your_stripe_client_id_here
STRIPE_CLIENT_SECRET=your_stripe_client_secret_here
STRIPE_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/stripe/callback

# Salesforce OAuth
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here
SALESFORCE_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/salesforce/callback

# Google Workspace OAuth
GOOGLE_WORKSPACE_CLIENT_ID=your_google_workspace_client_id_here
GOOGLE_WORKSPACE_CLIENT_SECRET=your_google_workspace_client_secret_here
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/google-workspace/callback

# Shopify OAuth
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
SHOPIFY_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/shopify/callback

# Microsoft 365 OAuth
MICROSOFT_365_CLIENT_ID=your_microsoft_365_client_id_here
MICROSOFT_365_CLIENT_SECRET=your_microsoft_365_client_secret_here
MICROSOFT_365_REDIRECT_URI=http://localhost:8001/api/v1/marketplace/oauth/microsoft-365/callback

# OAuth Setup Instructions:
# 1. QuickBooks: https://developer.intuit.com/app/developer/apps
# 2. Stripe: https://dashboard.stripe.com/account/applications
# 3. Salesforce: https://developer.salesforce.com/
# 4. Google: https://console.cloud.google.com/apis/credentials
# 5. Shopify: https://partners.shopify.com/
# 6. Microsoft: https://portal.azure.com/

# Note: For production on Varity L3, update redirect URIs to your domain