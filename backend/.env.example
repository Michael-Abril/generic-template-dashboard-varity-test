# Varity Generic Template - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql+asyncpg://varity:varity_secure_password_change_in_production@localhost:5432/varity
REDIS_URL=redis://localhost:6379

# ============================================================================
# OLLAMA LLM CONFIGURATION
# ============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ============================================================================
# PINATA CONFIGURATION (Filecoin/IPFS Gateway)
# ============================================================================
# Get your API keys from: https://app.pinata.cloud/developers/api-keys
#
# Instructions:
# 1. Sign up at https://pinata.cloud (free tier available)
# 2. Go to API Keys section
# 3. Create a new API key with permissions:
#    - pinFileToIPFS
#    - pinJSONToIPFS
#    - unpin
#    - pinList
# 4. Copy the API Key, API Secret, and JWT below

PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_token_here

# Optional: Custom Pinata gateway (defaults provided)
# PINATA_API_URL=https://api.pinata.cloud
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud


# ============================================================================
# LIT PROTOCOL CONFIGURATION
# ============================================================================
# Lit Protocol network for encryption/decryption
# Options: cayenne (testnet), habanero (testnet), manzano (mainnet)
LIT_NETWORK=cayenne

# Enable debug mode for Lit Protocol
LIT_DEBUG=false


# ============================================================================
# VARITY L3 BLOCKCHAIN CONFIGURATION
# ============================================================================
# Varity L3 Testnet Configuration (Arbitrum Orbit - Conduit)
VARITY_L3_RPC=https://rpc-varity-testnet-rroe52pwjp.t.conduit.xyz
VARITY_L3_CHAIN_ID=33529
VARITY_CHAIN_NAME=Varity L3 Testnet

# Data Commitments Smart Contract
# Deploy with: npx hardhat deploy --network varity-testnet
# Once deployed, set this to the contract address
VARITY_DATA_COMMITMENTS_ADDRESS=

# L3 Signing Key (for committing data to L3)
# Generate with: openssl rand -hex 32
# WARNING: Keep this secret! Use Railway secrets in production
VARITY_L3_PRIVATE_KEY=

# Optional: Varity L3 Mainnet (when available)
# VARITY_L3_RPC=https://rpc-varity-mainnet.varity.network
# VARITY_L3_CHAIN_ID=33530
# VARITY_DATA_COMMITMENTS_ADDRESS=0x...


# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application settings
APP_NAME=Varity Generic Template Dashboard
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings (comma-separated origins)
# For development: http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# ============================================================================
# STORAGE SETTINGS
# ============================================================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=100

# Allowed integrations (comma-separated)
ALLOWED_INTEGRATIONS=google-workspace,quickbooks,salesforce,slack,credentials,documents,generic


# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json


# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Hot reload for development
RELOAD=true

# Test wallet address for development
TEST_WALLET_ADDRESS=0x1234567890abcdef1234567890abcdef12345678


# ============================================================================
# OAUTH INTEGRATION CONFIGURATION (10 Adapters)
# ============================================================================
# OAuth redirect URI (must match configuration in OAuth provider dashboards)
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# QuickBooks OAuth Configuration
# Get credentials from: https://developer.intuit.com
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret_here

# Salesforce OAuth Configuration
# Get credentials from: https://developer.salesforce.com
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here

# Shopify OAuth Configuration
# Get credentials from: https://partners.shopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# Stripe OAuth Configuration
# Get credentials from: https://dashboard.stripe.com/apikeys
STRIPE_CLIENT_ID=your_stripe_client_id_here
STRIPE_CLIENT_SECRET=your_stripe_client_secret_here

# Google Workspace OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# HubSpot OAuth Configuration
# Get credentials from: https://app.hubspot.com/developer
HUBSPOT_CLIENT_ID=your_hubspot_client_id_here
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here

# Slack OAuth Configuration
# Get credentials from: https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here

# Zendesk OAuth Configuration
# Get credentials from: https://developer.zendesk.com
ZENDESK_CLIENT_ID=your_zendesk_client_id_here
ZENDESK_CLIENT_SECRET=your_zendesk_client_secret_here

# Monday.com OAuth Configuration
# Get credentials from: https://monday.com/developers/apps
MONDAY_CLIENT_ID=your_monday_client_id_here
MONDAY_CLIENT_SECRET=your_monday_client_secret_here

# Microsoft 365 OAuth Configuration
# Get credentials from: https://portal.azure.com (Azure AD App Registrations)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Xero OAuth Configuration
# Get credentials from: https://developer.xero.com/app/manage
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here


# ============================================================================
# MODEL CONTEXT PROTOCOL (MCP) CONFIGURATION
# ============================================================================
# MCP enables native integration with 6 major business applications
# Each integration has an official or community-maintained MCP server
#
# MCP servers provide:
# - Type-safe data fetching (no manual API calls)
# - Automatic OAuth token handling
# - Built-in error recovery and retries
# - JSON-RPC 2.0 protocol over stdio
#
# Active MCP Servers:
# 1. Google Workspace (@anthropic/google-workspace-mcp)
# 2. Slack (korotovsky/slack-mcp-server)
# 3. QuickBooks (@anthropic/quickbooks-online-mcp-server)
# 4. Microsoft 365 (Softeria/ms-365-mcp-server)
# 5. Salesforce (Community/MCP-Salesforce)
# 6. HubSpot (@hubspot/mcp-server)
#
# Each integration uses its configured MCP server to fetch data.
# Data is ALWAYS encrypted before storage.

MCP_SERVERS_ENABLED=true


# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# CRITICAL SECURITY REQUIREMENTS:
#
# 1. NEVER commit the actual .env file to version control
# 2. Keep your Pinata API keys secret
# 3. Rotate API keys regularly
# 4. Use different keys for development and production
# 5. Enable API key IP restrictions in Pinata dashboard
# 6. Monitor Pinata usage for unusual activity
#
# DATA PRIVACY:
#
# - All data is encrypted with Lit Protocol before upload
# - Only the customer's wallet can decrypt their data
# - Pinata admins CANNOT read encrypted data
# - IPFS network CANNOT read encrypted data
# - This maintains Varity's "no corporate surveillance" promise
#
# PINATA FREE TIER LIMITS:
#
# - 1 GB storage
# - Unlimited pins
# - 100 API requests per second
#
# For production, consider upgrading to paid tier:
# https://pinata.cloud/pricing
